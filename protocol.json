{
  "protocol": "V380 Camera Protocol (Aliothings/AliOS Things variant)",
  "version": "1.1",
  "analysis_source": "REA/Ghidra analysis of libhsMediaLibrary.so, libhsUtils.so, libnms.so, libzerolink.so from com.macrovideo.v380pro.apk",
  "transport": {
    "control": "TCP (mr_tcp_connect)",
    "video": "UDP",
    "default_port": 5050,
    "discovery": "NOT NVDEVSEARCH^100 - uses MQTT/P2P via callbackMqErrorStartP2p"
  },
  "session_management": {
    "login": "LoginHelper.login(context, deviceInfo, 5) for P2P",
    "key_exchange": [
      "LoginHelper.keyExchangeFromMqSync",
      "LoginHelper.keyExchangeByLanSync", 
      "LoginHelper.keyExchangeFromHttpsSync"
    ],
    "token_refresh": [
      "refreshIpPortHandleToken",
      "refreshIpPortHandleTokenSession",
      "refreshIpPortHandleTokenUuid",
      "refreshMqKeyExchangeInfo"
    ],
    "structures": {
      "LoginHandle": {
        "mlHandle": "long (native handle)",
        "mnDeviceID": "int",
        "mlTokenSession": "long",
        "sid": "int (session ID)",
        "sKey": "byte[16] (AES key)",
        "pKeyByte": "byte[] (public key)",
        "mstrIP": "string (camera IP)",
        "mnPort": "int (default 5050)",
        "mstrDomain": "string (default 123.nvdvr.net)",
        "mbInLan": "boolean"
      }
    }
  },
  "encryption": {
    "algorithm": "AES-128-CBC",
    "key_size": 16,
    "iv_size": 16,
    "functions": [
      "iotc_ms_frame_cipher_init",
      "iotc_ms_frame_cipher",
      "iotc_ms_frame_cipher_end",
      "media_data_decrypt",
      "media_data_encrypt",
      "mvt_cipher_start",
      "mvt_cipher_process",
      "mvt_cipher_finish"
    ],
    "frame_info_struct": {
      "name": "_media_stream_frame_trans_info",
      "size": 312,
      "fields": [
        "cipher_mode (1=decrypt, 2=encrypt)",
        "frame_type",
        "key[16]",
        "iv[16]",
        "additional_data[280]"
      ]
    }
  },
  "video": {
    "frame_types": {
      "1": "VIDEO_FRAME (H.264/H.265)",
      "2": "AUDIO_FRAME (ADPCM)",
      "4": "OTHER/Metadata"
    },
    "frame_header": {
      "size": 20,
      "fields": [
        {"name": "offset", "offset": 16, "type": "uint32"},
        {"name": "size", "offset": 20, "type": "uint32"},
        {"name": "frame_type", "offset": 24, "type": "uint8"},
        {"name": "flags1", "offset": 25, "type": "uint8"},
        {"name": "flags2", "offset": 26, "type": "uint8"},
        {"name": "ts_low", "offset": 28, "type": "uint32"},
        {"name": "ts_high", "offset": 32, "type": "uint32"}
      ]
    },
    "tagFrameData": {
      "fields": {
        "+0": "frame_type (1=video, 2=audio, 4=other)",
        "+4": "timestamp",
        "+8": "sub_type",
        "+0xc": "frame_subtype",
        "+0x10": "pts_low",
        "+0x14": "pts_high",
        "+0x18": "width",
        "+0x1c": "height",
        "+0x20": "data_size",
        "+0x24": "data_offset",
        "+0x28": "flags",
        "+0x2c": "sequence",
        "+0x30": "stream_id",
        "+0x44": "extra_data"
      }
    },
    "fifo_queue": {
      "capacity": 100,
      "frame_header_size": 20,
      "functions": [
        "PutFIFOVedioData",
        "GetFIFOData", 
        "InitFIFOQueueManager",
        "InitQueueManager",
        "InitFrameCountQueueManager"
      ]
    },
    "flow": [
      "startPlay() -> HSMediaManager::startPlay(tagPlayParam)",
      "-> callbackPreviewReq() -> callbackPreviewRes()",
      "-> onRecvFrameData(tagFrameData*)",
      "-> PutFileFrameDataTime3() / PutAudioDataEX()"
    ]
  },
  "ptz": {
    "setPTZParam": {
      "params": 11,
      "signature": "setPTZParam(handle, cmd, bool1, param1, bool2, param2, bool3, bool4, bool5, bool6, param3)",
      "jni": "Java_com_macrovideo_sdk_media_HSMediaLibrary_setPTZParam"
