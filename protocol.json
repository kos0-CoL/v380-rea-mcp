{
  "protocol": "V380 Camera Protocol",
  "version": "1.0",
  "transport": "UDP",
  "default_port": 5050,
  "default_domain": "123.nvdvr.net",
  "encryption": "AES-128-CBC (iotc cipher)",
  "command_codes": {
    "0x30200": {
      "name": "SPEAK_AUDIO",
      "description": "Send audio data for two-way talk",
      "direction": "client->camera",
      "params": ["audio_data", "format", "sample_rate"]
    },
    "0x3030a": {
      "name": "KEEP_ALIVE",
      "description": "Heartbeat to maintain session",
      "direction": "bidirectional",
      "interval_ms": 4000,
      "params": ["status"],
      "response": ["ret", "token"]
    },
    "0x30300": {
      "name": "GENERAL_CTRL",
      "description": "General control commands",
      "direction": "client->camera",
      "params": ["action", "value"]
    },
    "0x30308": {
      "name": "PTZ_ACTION",
      "description": "PTZ movement and control",
      "direction": "client->camera",
      "params": ["action", "pan", "tilt", "zoom", "speed", "preset_id"],
      "actions": ["move", "stop", "preset", "zoom", "focus", "iris"]
    },
    "0x30202": {
      "name": "PTZ_PRESET",
      "description": "PTZ preset management",
      "direction": "client->camera",
      "params": ["action", "preset_id", "name"],
      "actions": ["set", "goto", "delete"]
    },
    "0x30222": {
      "name": "PLAYBACK_CTRL",
      "description": "Playback control for recordings",
      "direction": "client->camera",
      "params": ["action", "timestamp", "speed"]
    },
    "0x60200": {
      "name": "PTZ_ZOOM",
      "description": "Zoom control",
      "direction": "client->camera",
      "params": ["zoom_level"]
    },
    "0x60201": {
      "name": "PTZ_FOCUS",
      "description": "Focus control",
      "direction": "client->camera",
      "params": ["focus_level", "auto"]
    },
    "0x60203": {
      "name": "PTZ_IRIS",
      "description": "Iris control",
      "direction": "client->camera",
      "params": ["iris_level"]
    },
    "0x60204": {
      "name": "PTZ_OTHER",
      "description": "Other PTZ actions",
      "direction": "client->camera",
      "params": ["action_id"]
    }
  },
  "frame_types": {
    "0": "I_FRAME",
    "2": "P_FRAME",
    "9": "IDR_FRAME",
    "36": "SPS_PPS",
    "40": "SEI",
    "50": "AUD",
    "52": "FILLER"
  },
  "key_frame_types": [0, 2, 9, 36, 40, 50, 52],
  "session_management": {
    "login_handle_fields": [
      "mlHandle", "mnDeviceID", "mlTokenSession", "sid",
      "sKey", "pKeyByte", "mstrIP", "mstrLanIP",
      "mnPort", "mstrDomain", "mbInLan"
    ],
    "refresh_functions": [
      "refreshIpPortHandleToken",
      "refreshSession",
      "refreshMqKeyExchangeInfo",
      "refreshIpPortHandleTokenSession",
      "refreshIpPortHandleTokenUuid",
      "updateLoginHandle"
    ]
  },
  "frame_header": {
    "size": 20,
    "fields": [
      {"name": "offset", "offset": 16, "type": "uint32"},
      {"name": "size", "offset": 20, "type": "uint32"},
      {"name": "type", "offset": 24, "type": "uint8"},
      {"name": "flags1", "offset": 25, "type": "uint8"},
      {"name": "flags2", "offset": 26, "type": "uint8"},
      {"name": "ts_low", "offset": 28, "type": "uint32"},
      {"name": "ts_high", "offset": 32, "type": "uint32"}
    ]
  },
  "encryption": {
    "algorithm": "AES-128-CBC",
    "key_size": 16,
    "iv_size": 16,
    "functions": [
      "iotc_ms_frame_cipher_init",
      "iotc_ms_frame_cipher",
      "iotc_ms_frame_cipher_end"
    ]
  },
  "audio": {
    "codec": "ADPCM",
    "sample_rate": 8000,
    "channels": 1,
    "functions": ["AdpcmEncode", "AdpcmDecode", "sample8kTo16k"]
  },
  "ptz": {
    "setPTZParam_params": 11,
    "setPTZXParam_params": 3,
    "range": {
      "pan": [-100, 100],
      "tilt": [-100, 100],
      "zoom": [0, 100],
      "speed": [1, 10]
    }
  },
  "error_codes": {
    "0": "SUCCESS",
    "-1": "GENERIC_FAILURE",
    "-2": "INVALID_PARAMETER",
    "-3": "NOT_CONNECTED",
    "-4": "TIMEOUT",
    "-5": "AUTH_FAILED",
    "-6": "SESSION_EXPIRED",
    "-7": "ENCRYPTION_ERROR",
    "-8": "BUFFER_FULL",
    "-9": "NOT_SUPPORTED"
  }
}
