        "mnDeviceID": "int",
        "mlTokenSession": "long",
        "sid": "int (session ID)",
        "sKey": "byte[16] (AES key)",
        "pKeyByte": "byte[] (public key)",
        "mstrIP": "string (camera IP)",
        "mnPort": "int (default 5050)",
        "mstrDomain": "string (default 123.nvdvr.net)",
        "mbInLan": "boolean"
      }
    }
  },
  "encryption": {
    "algorithm": "AES-128-CBC",
    "key_size": 16,
    "iv_size": 16,
    "functions": [
      "iotc_ms_frame_cipher_init",
